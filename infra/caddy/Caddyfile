{
	# Uncomment this debug line when needed
	# debug
}

(strip-headers-add-request-id) {
	request_header -X-User-*
	request_header X-Request-Id {http.request.uuid}
}

(verify-auth) {
	forward_auth user {
		uri /verify
		copy_headers {
			X-User-Id
			X-User-Roles
		}
	}
}

localhost {
	@verify-path path /verify

	# strip any headers, that would be used internally by the services
	import strip-headers-add-request-id

	handle /api/* {
		# for ordered matching, reward public paths must come first to avoid conflicts with user public paths
		route {
			@reward-public-paths {
				method GET
				path /api/public/profiles/*/stats /api/public/stats
			}

			handle @reward-public-paths {
				reverse_proxy reward
			}

			@user-public-paths <<CEL
				(method('POST') && path('/api/session', '/api/accounts')) ||
				(method('DELETE') && path('/api/session')) ||
				(method('GET') && path('/api/terms', '/api/public/profiles/*'))
				CEL

			handle @user-public-paths {
				reverse_proxy user
			}

			# goes inside route because a `handle` sibling to a `route` always uses `handle` first 
			handle {
				error "Not found" 404
			}
		}

		@user-paths <<CEL
			(method('GET') && path('/api/profile')) ||
			(method('PATCH') && path('/api/profile')) ||
			(method('POST') && path('/api/profile/roles')) ||
			(method('DELETE') && path('/api/profile'))
			CEL

		handle @user-paths {
			import verify-auth
			reverse_proxy user
		}

		@request-paths path /api/categories /api/categories/* /api/requests /api/requests/* /api/profile /api/profile/*

		handle @request-paths {
			import verify-auth
			reverse_proxy request
		}

		@notification-public-paths path /api/public/events

		@notification-paths path /api/events /api/notifications /api/notifications/* /api/push/subscriptions

		handle @notification-paths {
			import verify-auth
			reverse_proxy notification
		}
	}

	handle @verify-path {
		error "Not found" 404
	}

	handle {
		reverse_proxy frontend:3000
	}

	handle_errors {
		handle /api/* {
			header Content-Type application/json
			respond `{"status": {err.status_code}, "error": "{err.message}"}`
		}
	}
}
