{
	# Uncomment this debug line when needed
	# debug
}

(strip-headers-add-request-id) {
	request_header -X-User-*
	request_header X-Request-Id {http.request.uuid}
}

(verify-auth) {
	forward_auth user {
		uri /verify
		copy_headers {
			X-User-Id
			X-User-Roles
		}
	}
}

localhost {
	# strip any headers, that would be used internally by the services
	import strip-headers-add-request-id

	handle /api/* {
		# reward paths, public
		@reward-public-paths <<CEL
			(method('GET') && (path('/api/public/stats') || path_regexp('^/api/public/profiles/[^/]+/stats$')))
			CEL

		handle @reward-public-paths {
			reverse_proxy reward
		}

		# reward paths, auth
		@reward-paths <<CEL
			(method('GET') && path('/api/ecopoints'))
			CEL

		handle @reward-paths {
			import verify-auth
			reverse_proxy reward
		}

		# user paths, public
		@user-public-paths <<CEL
			(method('POST', 'DELETE') && path('/api/session')) ||
			(method('POST') && path('/api/accounts')) ||
			(method('GET') && (path('/api/terms') || path_regexp('^/api/public/profiles/[^/]+$')))
			CEL

		handle @user-public-paths {
			reverse_proxy user
		}

		# user paths, auth
		@user-paths <<CEL
			(method('GET', 'PATCH', 'DELETE') && path('/api/profile')) ||
			(method('POST') && path('/api/profile/roles'))
			CEL

		handle @user-paths {
			import verify-auth
			reverse_proxy user
		}

		# request paths, auth
		@request-paths <<CEL
			(method('GET') && (path('/api/categories', '/api/facilities', '/api/requests') || path_regexp('^/api/requests/[^/]+$'))) ||
			(method('POST') && (path('/api/uploads', '/api/requests') || path_regexp('^/api/requests/[^/]+/(cancel|assignment|assignment/(cancel|collected|missed|delivery))$'))) ||
			(method('PATCH') && path_regexp('^/api/requests/[^/]+$'))
			CEL

		handle @request-paths {
			import verify-auth
			reverse_proxy request
		}

		# notification paths, public

		@notification-public-paths <<CEL
			(method('GET') && path('/api/public/events'))
			CEL

		handle @notification-public-paths {
			reverse_proxy notification
		}

		@notification-paths <<CEL
			(method('GET') && path('/api/events', '/api/notifications')) ||
			(method('PATCH') && path_regexp('^/api/notifications/[^/]+/read$')) ||
			(method('POST') && path('/api/notifications/read-all', '/api/push/subscriptions')) ||
			(method('DELETE') && path('/api/push/subscriptions'))
			CEL

		handle @notification-paths {
			import verify-auth
			reverse_proxy notification
		}

		handle {
			error "Not found" 404
		}
	}

	@verify-path path /verify

	handle @verify-path {
		error "Not found" 404
	}

	handle {
		reverse_proxy frontend:3000
	}

	handle_errors {
		handle /api/* {
			header Content-Type application/json
			respond `{"status": {err.status_code}, "error": "{err.message}"}` {err.status_code}
		}
	}
}
