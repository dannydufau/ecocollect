:80 {
	@get-request-verify {
		method GET
		path /verify
	}

	@good-resident header Authorization "Bearer good-resident"
	@good-volunteer header Authorization "Bearer good-volunteer"
	@good-cookie-resident header_regexp Cookie "session=good-resident"
	@good-cookie-volunteer header_regexp Cookie "session=good-volunteer"

	handle @get-request-verify {
		handle @good-resident {
			header X-User-Id "resident-id-1"
			header X-User-Roles "resident"
			respond "Name: user" 200
		}

		handle @good-cookie-resident {
			header X-User-Id "resident-id-1"
			header X-User-Roles "resident"
			respond "Name: user" 200
		}

		handle @good-volunteer {
			header X-User-Id "volunteer-id-1"
			header X-User-Roles "volunteer"
			respond "Name: user" 200
		}

		handle @good-cookie-volunteer {
			header X-User-Id "volunteer-id-1"
			header X-User-Roles "volunteer"
			respond "Name: user" 200
		}

		handle {
			error "Name: user. Unauthorized" 401
		}
	}

	@user-get {
		method GET
	}

	@user-post {
		method POST
	}

	@user-patch {
		method PATCH
	}

	@user-delete {
		method DELETE
	}

	handle /api/session {
		handle @user-post {
			header Set-Cookie "session=good-resident; Path=/; SameSite=Lax"
			respond "Name: user" 204
		}
		handle @user-delete {
			header Set-Cookie "session=; Max-Age=0; Path=/; SameSite=Lax"
			respond "Name: user" 204
		}
	}

	handle /api/accounts {
		handle @user-post {
			error "Name: user" 400
		}
	}

	handle /api/terms {
		handle @user-get {
			respond "Name: user. Terms document" 200
		}
	}

	handle /api/public/profiles/* {
		handle @user-get {
			error "Name: user. No public profile found." 404
		}
	}

	handle /api/profile {
		handle @user-get {
			respond "Name: user. User profile" 200
		}
		handle @user-patch {
			respond "Name: user. User updated" 200
		}
		handle @user-delete {
			respond "Name: user. User deactivated" 204
		}
	}

	handle /api/profile/roles {
		handle @user-post {
			respond "Name: user. User role activated" 200
		}
	}

	handle {
		error "Unauthorized" 401
	}

	handle_errors {
		header Content-Type application/json
		respond `{"status": {err.status_code}, "error": "{err.message}"}`
	}
}
