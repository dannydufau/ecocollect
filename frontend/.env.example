# Copy to .env.local and fill in real values. Never commit .env.local.

# Firebase web config: Firebase console > Project settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ecocollect-uofc.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ecocollect-uofc
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Gateway (Caddy) that /api/* is proxied to by the Next.js rewrite. Server side only.
GATEWAY_URL=http://localhost:8080
