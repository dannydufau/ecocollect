        <mxCell id="FiZMqvlng4lK8YH4NTxv-677" parent="1" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=2;spacingLeft=2;fontSize=11;fontFamily=Helvetica;fontColor=default;fontStyle=0;" value="&lt;div style=&quot;font-family:Helvetica,Arial,sans-serif; font-size:12px; line-height:1.35;&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:17px;&quot;&gt;Relational Schema&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;account(&lt;u&gt;account_id&lt;/u&gt;, first_name, last_name, public_name, date_of_birth, created_at, deactivated_at)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;PK: account_id&lt;br&gt;&amp;nbsp;&amp;nbsp;Types: account_id VARCHAR(50); first_name VARCHAR(80); last_name VARCHAR(80); public_name VARCHAR(80); date_of_birth DATE; created_at TIMESTAMPTZ; deactivated_at TIMESTAMPTZ&lt;br&gt;&lt;br&gt;&lt;b&gt;resident(&lt;u&gt;account_id#&lt;/u&gt;, street, postal_code)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;PK: account_id&lt;br&gt;&amp;nbsp;&amp;nbsp;Types: account_id VARCHAR(50); street VARCHAR(255); postal_code CHAR(6)&lt;br&gt;&amp;nbsp;&amp;nbsp;FK: account_id → account.account_id&lt;br&gt;&lt;br&gt;&lt;b&gt;volunteer(&lt;u&gt;account_id#&lt;/u&gt;)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;PK: account_id&lt;br&gt;&amp;nbsp;&amp;nbsp;Types: account_id VARCHAR(50)&lt;br&gt;&amp;nbsp;&amp;nbsp;FK: account_id → account.account_id&lt;br&gt;&lt;br&gt;&lt;b&gt;volunteer_preferred_postal_code(&lt;u&gt;account_id#&lt;/u&gt;, &lt;u&gt;postal_code&lt;/u&gt;)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;PK: account_id, postal_code&lt;br&gt;&amp;nbsp;&amp;nbsp;Types: account_id VARCHAR(50); postal_code CHAR(6)&lt;br&gt;&amp;nbsp;&amp;nbsp;FK: account_id → volunteer.account_id&lt;br&gt;&lt;br&gt;&lt;b&gt;push_subscription(&lt;u&gt;endpoint&lt;/u&gt;, account_id#, p256dh, auth, expiration_time, user_agent, updated_at)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;PK: endpoint&lt;br&gt;&amp;nbsp;&amp;nbsp;Types: endpoint TEXT; account_id VARCHAR(50); p256dh TEXT; auth TEXT; expiration_time TIMESTAMPTZ; user_agent TEXT; updated_at TIMESTAMPTZ&lt;br&gt;&amp;nbsp;&amp;nbsp;FK: account_id → account.account_id&lt;br&gt;&lt;br&gt;&lt;b&gt;terms_document(&lt;u&gt;terms_document_id&lt;/u&gt;, content, published_at)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;PK: terms_document_id&lt;br&gt;&amp;nbsp;&amp;nbsp;Types: terms_document_id UUID; content TEXT; published_at TIMESTAMPTZ&lt;br&gt;&lt;br&gt;&lt;b&gt;terms_acceptance(&lt;u&gt;terms_acceptance_id&lt;/u&gt;, terms_document_id#, account_id#, accepted_at, type)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;PK: terms_acceptance_id&lt;br&gt;&amp;nbsp;&amp;nbsp;Types: terms_acceptance_id UUID; terms_document_id UUID; account_id VARCHAR(50); accepted_at TIMESTAMPTZ; type VARCHAR(40)&lt;br&gt;&amp;nbsp;&amp;nbsp;FK: terms_document_id → terms_document.terms_document_id; account_id → account.account_id&lt;br&gt;&lt;br&gt;&lt;b&gt;item_category(&lt;u&gt;category_id&lt;/u&gt;, name, waste_type, standard_weight_kg)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;PK: category_id&lt;br&gt;&amp;nbsp;&amp;nbsp;Types: category_id TEXT; name VARCHAR(120); waste_type VARCHAR(120); standard_weight_kg NUMERIC(10,2)&lt;br&gt;&lt;br&gt;&lt;b&gt;photo(&lt;u&gt;file_id&lt;/u&gt;, file_path)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;PK: file_id&lt;br&gt;&amp;nbsp;&amp;nbsp;Types: file_id TEXT; file_path TEXT&lt;br&gt;&lt;br&gt;&lt;b&gt;pickup_request(&lt;u&gt;pickup_request_id&lt;/u&gt;, account_id#, category_id#, terms_acceptance_id#, quantity, estimated_weight_kg, created_at, request_seq, pickup_street, pickup_postal_code, notes, file_id#, rescheduled_from_request_id#)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;PK: pickup_request_id&lt;br&gt;&amp;nbsp;&amp;nbsp;Types: pickup_request_id UUID; account_id VARCHAR(50); category_id TEXT; terms_acceptance_id UUID; quantity INTEGER; estimated_weight_kg NUMERIC(22,2); created_at TIMESTAMPTZ; request_seq BIGINT; pickup_street VARCHAR(255); pickup_postal_code CHAR(6); notes TEXT; file_id TEXT; rescheduled_from_request_id UUID&lt;br&gt;&amp;nbsp;&amp;nbsp;FK: account_id → resident.account_id; category_id → item_category.category_id; terms_acceptance_id → terms_acceptance.terms_acceptance_id; file_id → photo.file_id; rescheduled_from_request_id → pickup_request.pickup_request_id&lt;br&gt;&lt;br&gt;&lt;b&gt;pickup_window(&lt;u&gt;pickup_window_id&lt;/u&gt;, pickup_request_id#, pickup_date, start_hour, is_active)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;PK: pickup_window_id&lt;br&gt;&amp;nbsp;&amp;nbsp;Types: pickup_window_id UUID; pickup_request_id UUID; pickup_date DATE; start_hour SMALLINT; is_active BOOLEAN&lt;br&gt;&amp;nbsp;&amp;nbsp;FK: pickup_request_id → pickup_request.pickup_request_id&lt;br&gt;&lt;br&gt;&lt;b&gt;status_change(&lt;u&gt;pickup_request_id#&lt;/u&gt;, &lt;u&gt;changed_at&lt;/u&gt;, status, reason)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;PK: pickup_request_id, changed_at&lt;br&gt;&amp;nbsp;&amp;nbsp;Types: pickup_request_id UUID; changed_at TIMESTAMPTZ; status VARCHAR(30); reason TEXT&lt;br&gt;&amp;nbsp;&amp;nbsp;FK: pickup_request_id → pickup_request.pickup_request_id&lt;br&gt;&lt;br&gt;&lt;b&gt;assignment(&lt;u&gt;assignment_id&lt;/u&gt;, pickup_request_id#, volunteer_id#, pickup_window_id#, terms_acceptance_id#, accepted_at, collected_at, ended_at, end_reason)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;PK: assignment_id&lt;br&gt;&amp;nbsp;&amp;nbsp;Types: assignment_id UUID; pickup_request_id UUID; volunteer_id VARCHAR(50); pickup_window_id UUID; terms_acceptance_id UUID; accepted_at TIMESTAMPTZ; collected_at TIMESTAMPTZ; ended_at TIMESTAMPTZ; end_reason VARCHAR(30)&lt;br&gt;&amp;nbsp;&amp;nbsp;FK: pickup_request_id → pickup_request.pickup_request_id; volunteer_id → volunteer.account_id; pickup_window_id → pickup_window.pickup_window_id; terms_acceptance_id → terms_acceptance.terms_acceptance_id&lt;br&gt;&lt;br&gt;&lt;b&gt;delivery(&lt;u&gt;delivery_id&lt;/u&gt;, assignment_id#, facility_id#, file_id#)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;PK: delivery_id&lt;br&gt;&amp;nbsp;&amp;nbsp;Types: delivery_id UUID; assignment_id UUID; facility_id UUID; file_id TEXT&lt;br&gt;&amp;nbsp;&amp;nbsp;FK: assignment_id → assignment.assignment_id; facility_id → recycling_facility.facility_id; file_id → photo.file_id&lt;br&gt;&lt;br&gt;&lt;b&gt;recycling_facility(&lt;u&gt;facility_id&lt;/u&gt;, name, street, postal_code, special_instructions)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;PK: facility_id&lt;br&gt;&amp;nbsp;&amp;nbsp;Types: facility_id UUID; name VARCHAR(120); street VARCHAR(255); postal_code CHAR(6); special_instructions TEXT&lt;br&gt;&lt;br&gt;&lt;b&gt;facility_accepts(&lt;u&gt;facility_id#&lt;/u&gt;, &lt;u&gt;category_id#&lt;/u&gt;)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;PK: facility_id, category_id&lt;br&gt;&amp;nbsp;&amp;nbsp;Types: facility_id UUID; category_id TEXT&lt;br&gt;&amp;nbsp;&amp;nbsp;FK: facility_id → recycling_facility.facility_id; category_id → item_category.category_id&lt;br&gt;&lt;br&gt;&lt;b&gt;ecopoints_award(&lt;u&gt;ecopoints_award_id&lt;/u&gt;, assignment_id#, resident_id#, volunteer_id#, points, formula)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;PK: ecopoints_award_id&lt;br&gt;&amp;nbsp;&amp;nbsp;Types: ecopoints_award_id UUID; assignment_id UUID; resident_id VARCHAR(50); volunteer_id VARCHAR(50); points NUMERIC(23,2); formula TEXT&lt;br&gt;&amp;nbsp;&amp;nbsp;FK: assignment_id → assignment.assignment_id; resident_id → resident.account_id; volunteer_id → volunteer.account_id&lt;br&gt;&lt;br&gt;&lt;b&gt;notification(&lt;u&gt;notification_id&lt;/u&gt;, account_id#, pickup_request_id#, ecopoints_award_id#, type, created_at, pushed_at, metadata, is_read, is_expired)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;PK: notification_id&lt;br&gt;&amp;nbsp;&amp;nbsp;Types: notification_id UUID; account_id VARCHAR(50); pickup_request_id UUID; ecopoints_award_id UUID; type VARCHAR(80); created_at TIMESTAMPTZ; pushed_at TIMESTAMPTZ; metadata JSONB; is_read BOOLEAN; is_expired BOOLEAN&lt;br&gt;&amp;nbsp;&amp;nbsp;FK: account_id → account.account_id; pickup_request_id → pickup_request.pickup_request_id; ecopoints_award_id → ecopoints_award.ecopoints_award_id&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
