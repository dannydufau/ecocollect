        <mxCell id="relational-schema" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#000000;" value="&lt;b style=&quot;font-size:24px&quot;&gt;Relational Schema&lt;/b&gt;&lt;p&gt;PK attributes are underlined. # marks a foreign key. NULL marks an optional attribute.&lt;/p&gt;&lt;p style=&quot;margin:0 0 18px 0;line-height:1.4&quot;&gt;&lt;b&gt;account(&lt;u&gt;account_id&lt;/u&gt;, first_name, last_name, public_name, date_of_birth, created_at, deactivated_at)&lt;/b&gt;&lt;br&gt;PK: account_id&lt;br&gt;Types: account_id VARCHAR(50); first_name VARCHAR(80); last_name VARCHAR(80); public_name VARCHAR(80); date_of_birth DATE; created_at TIMESTAMPTZ; deactivated_at TIMESTAMPTZ NULL&lt;/p&gt;&lt;p style=&quot;margin:0 0 18px 0;line-height:1.4&quot;&gt;&lt;b&gt;resident(&lt;u&gt;account_id#&lt;/u&gt;, street, postal_code)&lt;/b&gt;&lt;br&gt;PK: account_id&lt;br&gt;Types: account_id VARCHAR(50); street VARCHAR(255); postal_code CHAR(6)&lt;br&gt;FK: (account_id) → account(account_id)&lt;/p&gt;&lt;p style=&quot;margin:0 0 18px 0;line-height:1.4&quot;&gt;&lt;b&gt;volunteer(&lt;u&gt;account_id#&lt;/u&gt;)&lt;/b&gt;&lt;br&gt;PK: account_id&lt;br&gt;Types: account_id VARCHAR(50)&lt;br&gt;FK: (account_id) → account(account_id)&lt;/p&gt;&lt;p style=&quot;margin:0 0 18px 0;line-height:1.4&quot;&gt;&lt;b&gt;volunteer_preferred_postal_code(&lt;u&gt;account_id#&lt;/u&gt;, &lt;u&gt;postal_code&lt;/u&gt;)&lt;/b&gt;&lt;br&gt;PK: account_id, postal_code&lt;br&gt;Types: account_id VARCHAR(50); postal_code CHAR(6)&lt;br&gt;FK: (account_id) → volunteer(account_id)&lt;/p&gt;&lt;p style=&quot;margin:0 0 18px 0;line-height:1.4&quot;&gt;&lt;b&gt;push_subscription(&lt;u&gt;endpoint&lt;/u&gt;, account_id#, p256dh, auth, expiration_time, user_agent, updated_at)&lt;/b&gt;&lt;br&gt;PK: endpoint&lt;br&gt;Types: endpoint TEXT; account_id VARCHAR(50); p256dh TEXT; auth TEXT; expiration_time TIMESTAMPTZ NULL; user_agent TEXT NULL; updated_at TIMESTAMPTZ&lt;br&gt;FK: (account_id) → account(account_id)&lt;/p&gt;&lt;p style=&quot;margin:0 0 18px 0;line-height:1.4&quot;&gt;&lt;b&gt;terms_document(&lt;u&gt;terms_document_id&lt;/u&gt;, content, published_at)&lt;/b&gt;&lt;br&gt;PK: terms_document_id&lt;br&gt;Types: terms_document_id UUID; content TEXT; published_at TIMESTAMPTZ&lt;/p&gt;&lt;p style=&quot;margin:0 0 18px 0;line-height:1.4&quot;&gt;&lt;b&gt;terms_acceptance(&lt;u&gt;terms_acceptance_id&lt;/u&gt;, terms_document_id#, account_id#, accepted_at, type)&lt;/b&gt;&lt;br&gt;PK: terms_acceptance_id&lt;br&gt;Types: terms_acceptance_id UUID; terms_document_id UUID; account_id VARCHAR(50); accepted_at TIMESTAMPTZ; type VARCHAR(40)&lt;br&gt;FK: (account_id) → account(account_id); (terms_document_id) → terms_document(terms_document_id)&lt;/p&gt;&lt;p style=&quot;margin:0 0 18px 0;line-height:1.4&quot;&gt;&lt;b&gt;item_category(&lt;u&gt;category_id&lt;/u&gt;, name, waste_type, standard_weight_kg)&lt;/b&gt;&lt;br&gt;PK: category_id&lt;br&gt;Types: category_id TEXT; name VARCHAR(120); waste_type VARCHAR(120); standard_weight_kg NUMERIC(10,2)&lt;/p&gt;&lt;p style=&quot;margin:0 0 18px 0;line-height:1.4&quot;&gt;&lt;b&gt;photo(&lt;u&gt;file_id&lt;/u&gt;, file_path)&lt;/b&gt;&lt;br&gt;PK: file_id&lt;br&gt;Types: file_id TEXT; file_path TEXT&lt;/p&gt;&lt;p style=&quot;margin:0 0 18px 0;line-height:1.4&quot;&gt;&lt;b&gt;pickup_request(&lt;u&gt;pickup_request_id&lt;/u&gt;, category_id#, terms_acceptance_id#, quantity, estimated_weight_kg, created_at, request_seq, pickup_street, pickup_postal_code, notes, file_id#, rescheduled_from_request_id#)&lt;/b&gt;&lt;br&gt;PK: pickup_request_id&lt;br&gt;Types: pickup_request_id UUID; category_id TEXT; terms_acceptance_id UUID; quantity INTEGER; estimated_weight_kg NUMERIC(22,2); created_at TIMESTAMPTZ; request_seq BIGINT; pickup_street VARCHAR(255); pickup_postal_code CHAR(6); notes TEXT NULL; file_id TEXT NULL; rescheduled_from_request_id UUID NULL&lt;br&gt;UQ: (rescheduled_from_request_id)&lt;br&gt;FK: (category_id) → item_category(category_id); (file_id) → photo(file_id); (rescheduled_from_request_id) → pickup_request(pickup_request_id); (terms_acceptance_id) → terms_acceptance(terms_acceptance_id)&lt;/p&gt;&lt;p style=&quot;margin:0 0 18px 0;line-height:1.4&quot;&gt;&lt;b&gt;pickup_window(&lt;u&gt;pickup_window_id&lt;/u&gt;, pickup_request_id#, pickup_date, start_hour, is_active)&lt;/b&gt;&lt;br&gt;PK: pickup_window_id&lt;br&gt;Types: pickup_window_id UUID; pickup_request_id UUID; pickup_date DATE; start_hour SMALLINT; is_active BOOLEAN&lt;br&gt;FK: (pickup_request_id) → pickup_request(pickup_request_id)&lt;/p&gt;&lt;p style=&quot;margin:0 0 18px 0;line-height:1.4&quot;&gt;&lt;b&gt;status_change(&lt;u&gt;pickup_request_id#&lt;/u&gt;, &lt;u&gt;changed_at&lt;/u&gt;, status, reason)&lt;/b&gt;&lt;br&gt;PK: pickup_request_id, changed_at&lt;br&gt;Types: pickup_request_id UUID; changed_at TIMESTAMPTZ; status VARCHAR(30); reason TEXT NULL&lt;br&gt;FK: (pickup_request_id) → pickup_request(pickup_request_id)&lt;/p&gt;&lt;p style=&quot;margin:0 0 18px 0;line-height:1.4&quot;&gt;&lt;b&gt;assignment(&lt;u&gt;assignment_id&lt;/u&gt;, pickup_window_id#, terms_acceptance_id#, accepted_at, collected_at, ended_at, end_reason)&lt;/b&gt;&lt;br&gt;PK: assignment_id&lt;br&gt;Types: assignment_id UUID; pickup_window_id UUID; terms_acceptance_id UUID; accepted_at TIMESTAMPTZ; collected_at TIMESTAMPTZ NULL; ended_at TIMESTAMPTZ NULL; end_reason VARCHAR(30) NULL&lt;br&gt;FK: (terms_acceptance_id) → terms_acceptance(terms_acceptance_id); (pickup_window_id) → pickup_window(pickup_window_id)&lt;/p&gt;&lt;p style=&quot;margin:0 0 18px 0;line-height:1.4&quot;&gt;&lt;b&gt;recycling_facility(&lt;u&gt;facility_id&lt;/u&gt;, name, street, postal_code, special_instructions)&lt;/b&gt;&lt;br&gt;PK: facility_id&lt;br&gt;Types: facility_id UUID; name VARCHAR(120); street VARCHAR(255); postal_code CHAR(6); special_instructions TEXT NULL&lt;/p&gt;&lt;p style=&quot;margin:0 0 18px 0;line-height:1.4&quot;&gt;&lt;b&gt;facility_accepts(&lt;u&gt;facility_id#&lt;/u&gt;, &lt;u&gt;category_id#&lt;/u&gt;)&lt;/b&gt;&lt;br&gt;PK: facility_id, category_id&lt;br&gt;Types: facility_id UUID; category_id TEXT&lt;br&gt;FK: (category_id) → item_category(category_id); (facility_id) → recycling_facility(facility_id)&lt;/p&gt;&lt;p style=&quot;margin:0 0 18px 0;line-height:1.4&quot;&gt;&lt;b&gt;delivery(&lt;u&gt;delivery_id&lt;/u&gt;, assignment_id#, facility_id#, file_id#)&lt;/b&gt;&lt;br&gt;PK: delivery_id&lt;br&gt;Types: delivery_id UUID; assignment_id UUID; facility_id UUID; file_id TEXT&lt;br&gt;UQ: (assignment_id); (file_id)&lt;br&gt;FK: (assignment_id) → assignment(assignment_id); (facility_id) → recycling_facility(facility_id); (file_id) → photo(file_id)&lt;/p&gt;&lt;p style=&quot;margin:0 0 18px 0;line-height:1.4&quot;&gt;&lt;b&gt;ecopoints_award(&lt;u&gt;ecopoints_award_id&lt;/u&gt;, assignment_id#, points, formula)&lt;/b&gt;&lt;br&gt;PK: ecopoints_award_id&lt;br&gt;Types: ecopoints_award_id UUID; assignment_id UUID; points NUMERIC(23,2); formula TEXT&lt;br&gt;FK: (assignment_id) → assignment(assignment_id)&lt;/p&gt;&lt;p style=&quot;margin:0 0 18px 0;line-height:1.4&quot;&gt;&lt;b&gt;resident_award(&lt;u&gt;ecopoints_award_id#&lt;/u&gt;)&lt;/b&gt;&lt;br&gt;PK: ecopoints_award_id&lt;br&gt;Types: ecopoints_award_id UUID&lt;br&gt;FK: (ecopoints_award_id) → ecopoints_award(ecopoints_award_id)&lt;/p&gt;&lt;p style=&quot;margin:0 0 18px 0;line-height:1.4&quot;&gt;&lt;b&gt;volunteer_award(&lt;u&gt;ecopoints_award_id#&lt;/u&gt;)&lt;/b&gt;&lt;br&gt;PK: ecopoints_award_id&lt;br&gt;Types: ecopoints_award_id UUID&lt;br&gt;FK: (ecopoints_award_id) → ecopoints_award(ecopoints_award_id)&lt;/p&gt;&lt;p style=&quot;margin:0 0 18px 0;line-height:1.4&quot;&gt;&lt;b&gt;notification(&lt;u&gt;notification_id&lt;/u&gt;, type, created_at, pushed_at, is_read, is_expired)&lt;/b&gt;&lt;br&gt;PK: notification_id&lt;br&gt;Types: notification_id UUID; type VARCHAR(80); created_at TIMESTAMPTZ; pushed_at TIMESTAMPTZ NULL; is_read BOOLEAN; is_expired BOOLEAN&lt;/p&gt;&lt;p style=&quot;margin:0 0 18px 0;line-height:1.4&quot;&gt;&lt;b&gt;request_event(&lt;u&gt;pickup_request_id#&lt;/u&gt;, &lt;u&gt;request_seq&lt;/u&gt;, transition_id)&lt;/b&gt;&lt;br&gt;PK: pickup_request_id, request_seq&lt;br&gt;Types: pickup_request_id UUID; request_seq BIGINT; transition_id UUID&lt;br&gt;FK: (pickup_request_id) → pickup_request(pickup_request_id)&lt;/p&gt;&lt;p style=&quot;margin:0 0 18px 0;line-height:1.4&quot;&gt;&lt;b&gt;request_update_event(&lt;u&gt;pickup_request_id#&lt;/u&gt;, &lt;u&gt;request_seq#&lt;/u&gt;, reason)&lt;/b&gt;&lt;br&gt;PK: pickup_request_id, request_seq&lt;br&gt;Types: pickup_request_id UUID; request_seq BIGINT; reason VARCHAR(10)&lt;br&gt;FK: (pickup_request_id, request_seq) → request_event(pickup_request_id, request_seq)&lt;/p&gt;&lt;p style=&quot;margin:0 0 18px 0;line-height:1.4&quot;&gt;&lt;b&gt;request_changed_field(&lt;u&gt;pickup_request_id#&lt;/u&gt;, &lt;u&gt;request_seq#&lt;/u&gt;, &lt;u&gt;field_name&lt;/u&gt;)&lt;/b&gt;&lt;br&gt;PK: pickup_request_id, request_seq, field_name&lt;br&gt;Types: pickup_request_id UUID; request_seq BIGINT; field_name VARCHAR(20)&lt;br&gt;FK: (pickup_request_id, request_seq) → request_update_event(pickup_request_id, request_seq)&lt;/p&gt;&lt;p style=&quot;margin:0 0 18px 0;line-height:1.4&quot;&gt;&lt;b&gt;request_notification(&lt;u&gt;notification_id#&lt;/u&gt;, account_id#, pickup_request_id#, request_seq#)&lt;/b&gt;&lt;br&gt;PK: notification_id&lt;br&gt;Types: notification_id UUID; account_id VARCHAR(50); pickup_request_id UUID; request_seq BIGINT&lt;br&gt;FK: (notification_id) → notification(notification_id); (account_id) → account(account_id); (pickup_request_id, request_seq) → request_event(pickup_request_id, request_seq)&lt;/p&gt;&lt;p style=&quot;margin:0 0 18px 0;line-height:1.4&quot;&gt;&lt;b&gt;award_notification(&lt;u&gt;notification_id#&lt;/u&gt;, ecopoints_award_id#)&lt;/b&gt;&lt;br&gt;PK: notification_id&lt;br&gt;Types: notification_id UUID; ecopoints_award_id UUID&lt;br&gt;UQ: (ecopoints_award_id)&lt;br&gt;FK: (notification_id) → notification(notification_id); (ecopoints_award_id) → ecopoints_award(ecopoints_award_id)&lt;/p&gt;">
          <mxGeometry x="950" y="1916" width="2070" height="3100" as="geometry" />
        </mxCell>
        <mxCell id="domain-rules" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#000000;" value="&lt;b style=&quot;font-size:24px&quot;&gt;Domain rules&lt;/b&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:16px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Attributes&lt;/td&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Domain&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Account IDs&lt;/td&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;3–50 lowercase characters from &lt;code&gt;a-z&lt;/code&gt;, &lt;code&gt;0-9&lt;/code&gt;, &lt;code&gt;_&lt;/code&gt; and &lt;code&gt;-&lt;/code&gt;; immutable username and Firebase UID. Email is held by Firebase (BR3, BR56).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Required names, IDs and file paths&lt;/td&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Non-empty text.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Postal codes&lt;/td&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Six uppercase Canadian letter/digit characters with no space. Application validation checks the Calgary address (BR7).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Date of birth&lt;/td&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;At least 18 at registration; birth date cannot be in the future (BR6).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Quantity and weights&lt;/td&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Positive integer quantity; positive exact standard and historical estimated weights. The system calculates the estimate at creation/edit (BR30–BR31).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;&lt;code&gt;start_hour&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Integer 0–23. Dates and hours are stored as Calgary local calendar values (BR32).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Request/event sequences&lt;/td&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Positive BIGINT. &lt;code&gt;pickup_request.request_seq&lt;/code&gt; tracks the latest published event. &lt;code&gt;request_event.request_seq&lt;/code&gt; is the historical sequence for the referenced event (BR61).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Status&lt;/td&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;&lt;code&gt;Open&lt;/code&gt;, &lt;code&gt;Assigned&lt;/code&gt;, &lt;code&gt;Collected&lt;/code&gt;, &lt;code&gt;Delivered&lt;/code&gt;, &lt;code&gt;Cancelled&lt;/code&gt;, &lt;code&gt;Expired&lt;/code&gt;, &lt;code&gt;Missed&lt;/code&gt; (BR18).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;End reason&lt;/td&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;&lt;code&gt;Delivered&lt;/code&gt;, &lt;code&gt;Resident_Cancelled&lt;/code&gt;, &lt;code&gt;Volunteer_Cancelled&lt;/code&gt;, &lt;code&gt;Missed_Pickup&lt;/code&gt; (BR23).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Terms type&lt;/td&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;&lt;code&gt;AT_RESIDENT_REGISTRATION_OR_ACTIVATION&lt;/code&gt;, &lt;code&gt;AT_VOLUNTEER_REGISTRATION_OR_ACTIVATION&lt;/code&gt;, &lt;code&gt;AT_RESIDENT_REQUEST_CREATION&lt;/code&gt;, &lt;code&gt;AT_VOLUNTEER_ACCEPTANCE&lt;/code&gt;.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Update reason&lt;/td&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;&lt;code&gt;edited&lt;/code&gt; or &lt;code&gt;reopened&lt;/code&gt;, from the RequestUpdated event.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Changed field&lt;/td&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;&lt;code&gt;category&lt;/code&gt;, &lt;code&gt;quantity&lt;/code&gt;, &lt;code&gt;notes&lt;/code&gt;, &lt;code&gt;windows&lt;/code&gt; or &lt;code&gt;photo&lt;/code&gt;; rows occur only for an &lt;code&gt;edited&lt;/code&gt; update.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Points and formula&lt;/td&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Positive exact &lt;code&gt;NUMERIC(23,2)&lt;/code&gt; points and the formula text used at award creation. Volunteer points are &lt;code&gt;3 * quantity + 4 * estimated_weight_kg&lt;/code&gt;; resident points are half that amount (BR41).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Booleans&lt;/td&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Required &lt;code&gt;is_active&lt;/code&gt;, &lt;code&gt;is_read&lt;/code&gt; and &lt;code&gt;is_expired&lt;/code&gt; values.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p style=&quot;line-height:1.45;margin:9px 0&quot;&gt;The request estimate uses &lt;code&gt;NUMERIC(22,2)&lt;/code&gt; to accommodate an integer quantity multiplied by a &lt;code&gt;NUMERIC(10,2)&lt;/code&gt; unit weight. Points use &lt;code&gt;NUMERIC(23,2)&lt;/code&gt; to accommodate the reward formula while retaining exact decimals.&lt;/p&gt;">
          <mxGeometry x="950" y="5100" width="2070" height="950" as="geometry" />
        </mxCell>
        <mxCell id="reference-categories" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#000000;" value="&lt;b style=&quot;font-size:24px&quot;&gt;ITEM_CATEGORY — Reference data&lt;/b&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:16px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Category ID&lt;/td&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Name&lt;/td&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Waste type&lt;/td&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Standard weight (kg)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;&lt;code&gt;laptops&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Computers/Laptops&lt;/td&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Computers&lt;/td&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;2.50&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;&lt;code&gt;desktops&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Computers/Desktops&lt;/td&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;Computers&lt;/td&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;8.00&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quot;&gt;&lt;code&gt;monitors&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b9a76c;padding:10px;vertical-align:top&quo