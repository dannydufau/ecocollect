        <mxCell id="notification" parent="1" vertex="1" value="&lt;div style=&quot;font-family:Arial;font-size:13px;width:700px&quot;&gt;&lt;div style=&quot;padding:12px;background:#193c52;color:white;font-size:18px;font-weight:bold&quot;&gt;notification&lt;/div&gt;&lt;table style=&quot;width:100%;border-collapse:collapse&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #e2e9ee&quot;&gt;notification_id&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;UUID&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;PK NN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #e2e9ee&quot;&gt;type&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;VARCHAR(80)&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;NN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #e2e9ee&quot;&gt;created_at&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;NN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #e2e9ee&quot;&gt;pushed_at&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #e2e9ee&quot;&gt;is_read&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;BOOLEAN&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;NN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #e2e9ee&quot;&gt;is_expired&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;BOOLEAN&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;NN&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;padding:10px;font-size:12px&quot;&gt;&lt;div style=&quot;margin-top:6px;overflow-wrap:anywhere&quot;&gt;PK (notification_id)&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=#bac8d2;fillColor=#ffffff;fontColor=#19303f;">
