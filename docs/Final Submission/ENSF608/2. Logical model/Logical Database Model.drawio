        <mxCell id="request_changed_field" parent="1" vertex="1" value="&lt;div style=&quot;font-family:Arial;font-size:13px;width:700px&quot;&gt;&lt;div style=&quot;padding:12px;background:#193c52;color:white;font-size:18px;font-weight:bold&quot;&gt;request_changed_field&lt;/div&gt;&lt;table style=&quot;width:100%;border-collapse:collapse&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #e2e9ee&quot;&gt;pickup_request_id&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;UUID&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;PK FK NN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #e2e9ee&quot;&gt;request_seq&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;BIGINT&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;PK FK NN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #e2e9ee&quot;&gt;field_name&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;VARCHAR(20)&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;PK NN&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;padding:10px;font-size:12px&quot;&gt;&lt;div style=&quot;margin-top:6px;overflow-wrap:anywhere&quot;&gt;PK (pickup_request_id, request_seq, field_name)&lt;/div&gt;&lt;div style=&quot;margin-top:6px;overflow-wrap:anywhere&quot;&gt;FK (pickup_request_id, request_seq) → request_update_event(pickup_request_id, request_seq)&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=#bac8d2;fillColor=#ffffff;fontColor=#19303f;">
          <mxGeometry x="780" y="403" width="700" height="246" as="geometry" />
        </mxCell>
        <mxCell id="request_notification" parent="1" vertex="1" value="&lt;div style=&quot;font-family:Arial;font-size:13px;width:700px&quot;&gt;&lt;div style=&quot;padding:12px;background:#193c52;color:white;font-size:18px;font-weight:bold&quot;&gt;request_notification&lt;/div&gt;&lt;table style=&quot;width:100%;border-collapse:collapse&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #e2e9ee&quot;&gt;notification_id&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;UUID&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;PK FK NN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #e2e9ee&quot;&gt;account_id&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;VARCHAR(50)&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;FK NN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #e2e9ee&quot;&gt;pickup_request_id&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;UUID&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;FK NN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #e2e9ee&quot;&gt;request_seq&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;BIGINT&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;FK NN&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;padding:10px;font-size:12px&quot;&gt;&lt;div style=&quot;margin-top:6px;overflow-wrap:anywhere&quot;&gt;PK (notification_id)&lt;/div&gt;&lt;div style=&quot;margin-top:6px;overflow-wrap:anywhere&quot;&gt;FK (notification_id) → notification(notification_id)&lt;/div&gt;&lt;div style=&quot;margin-top:6px;overflow-wrap:anywhere&quot;&gt;FK (account_id) → account(account_id)&lt;/div&gt;&lt;div style=&quot;margin-top:6px;overflow-wrap:anywhere&quot;&gt;FK (pickup_request_id, request_seq) → request_event(pickup_request_id, request_seq)&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=#bac8d2;fillColor=#ffffff;fontColor=#19303f;">
          <mxGeometry x="40" y="720" width="700" height="298" as="geometry" />
        </mxCell>
        <mxCell id="award_notification" parent="1" vertex="1" value="&lt;div style=&quot;font-family:Arial;font-size:13px;width:700px&quot;&gt;&lt;div style=&quot;padding:12px;background:#193c52;color:white;font-size:18px;font-weight:bold&quot;&gt;award_notification&lt;/div&gt;&lt;table style=&quot;width:100%;border-collapse:collapse&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #e2e9ee&quot;&gt;notification_id&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;UUID&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;PK FK NN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #e2e9ee&quot;&gt;ecopoints_award_id&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;UUID&lt;/td&gt;&lt;td style=&quot;padding:5px;border-bottom:1px solid #e2e9ee&quot;&gt;FK NN&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;padding:10px;font-size:12px&quot;&gt;&lt;div style=&quot;margin-top:6px;overflow-wrap:anywhere&quot;&gt;PK (notification_id)&lt;/div&gt;&lt;div style=&quot;margin-top:6px;overflow-wrap:anywhere&quot;&gt;UQ (ecopoints_award_id)&lt;/div&gt;&lt;div style=&quot;margin-top:6px;overflow-wrap:anywhere&quot;&gt;FK (notification_id) → notification(notification_id)&lt;/div&gt;&lt;div style=&quot;margin-top:6px;overflow-wrap:anywhere&quot;&gt;FK (ecopoints_award_id) → ecopoints_award(ecopoints_award_id)&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=#bac8d2;fillColor=#ffffff;fontColor=#19303f;">
          <mxGeometry x="780" y="679" width="700" height="240" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-5" name="Mapping and integrity rules">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1520" pageHeight="1400">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" parent="1" vertex="1" value="&lt;div style=&quot;font-family:Arial;font-size:28px;font-weight:bold&quot;&gt;EcoCollect - Mapping and integrity rules&lt;/div&gt;&lt;p style=&quot;font-family:Arial;font-size:14px&quot;&gt;The logical README defines the complete relation list, domains, nullability and enforcement requirements.&lt;/p&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=#bac8d2;fillColor=#ffffff;fontColor=#19303f;strokeColor=none;fillColor=none;">
          <mxGeometry x="40" y="30" width="1440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rule-0" parent="1" vertex="1" value="&lt;div style=&quot;font-family:Arial;padding:16px&quot;&gt;&lt;b style=&quot;font-size:18px&quot;&gt;Ownership and participants&lt;/b&gt;&lt;p style=&quot;font-size:15px;line-height:1.5&quot;&gt;Request owner = request → terms_acceptance.account_id, with resident role and request-creation action. Assignment volunteer = assignment → terms_acceptance.account_id, with volunteer role and acceptance action. Assignment request = assignment → pickup_window.pickup_request_id.&lt;/p&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=#bac8d2;fillColor=#ffffff;fontColor=#19303f;">
          <mxGeometry x="40" y="160" width="700" height="200" as="geometry" />
        </mxCell>
        <mxCell id="rule-1" parent="1" vertex="1" value="&lt;div style=&quot;font-family:Arial;padding:16px&quot;&gt;&lt;b style=&quot;font-size:18px&quot;&gt;History and timing&lt;/b&gt;&lt;p style=&quot;font-size:15px;line-height:1.5&quot;&gt;Each request has an initial Open status and one to three active windows. Active slots are unique per request/date/hour. Inactive windows and ended assignments remain available. Every replacement window ends within the original creation-time limit.&lt;/p&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=#bac8d2;fillColor=#ffffff;fontColor=#19303f;">
          <mxGeometry x="780" y="160" width="700" height="200" as="geometry" />
        </mxCell>
        <mxCell id="rule-2" parent="1" vertex="1" value="&lt;div style=&quot;font-family:Arial;padding:16px&quot;&gt;&lt;b style=&quot;font-size:18px&quot;&gt;One unfinished assignment&lt;/b&gt;&lt;p style=&quot;font-size:15px;line-height:1.5&quot;&gt;Serialize on the request row and inspect assignments through pickup_window. Reject a second unfinished assignment with a deferred constraint trigger or equivalent concurrency-safe transaction rule.&lt;/p&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=#bac8d2;fillColor=#ffffff;fontColor=#19303f;">
          <mxGeometry x="40" y="390" width="700" height="200" as="geometry" />
        </mxCell>
        <mxCell id="rule-3" parent="1" vertex="1" value="&lt;div style=&quot;font-family:Arial;padding:16px&quot;&gt;&lt;b style=&quot;font-size:18px&quot;&gt;Award subtypes&lt;/b&gt;&lt;p style=&quot;font-size:15px;line-height:1.5&quot;&gt;Every award occurs in exactly one of resident_award and volunteer_award. At most one award per assignment per role. Points and formula are historical award facts. Derive the recipient through the assignment and subtype membership.&lt;/p&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=#bac8d2;fillColor=#ffffff;fontColor=#19303f;">
          <mxGeometry x="780" y="390" width="700" height="200" as="geometry" />
        </mxCell>
        <mxCell id="rule-4" parent="1" vertex="1" value="&lt;div style=&quot;font-family:Arial;padding:16px&quot;&gt;&lt;b style=&quot;font-size:18px&quot;&gt;Notification subtypes&lt;/b&gt;&lt;p style=&quot;font-size:15px;line-height:1.5&quot;&gt;Every notification occurs in exactly one of request_notification and award_notification. A request notification stores its recipient and references one event. An award notification references one unique award and derives its recipient.&lt;/p&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=#bac8d2;fillColor=#ffffff;fontColor=#19303f;">
          <mxGeometry x="40" y="620" width="700" height="200" as="geometry" />
        </mxCell>
        <mxCell id="rule-5" parent="1" vertex="1" value="&lt;div style=&quot;font-family:Arial;padding:16px&quot;&gt;&lt;b style=&quot;font-size:18px&quot;&gt;Atomic event facts&lt;/b&gt;&lt;p style=&quot;font-size:15px;line-height:1.5&quot;&gt;request_event is keyed by request ID and request_seq. transition_id identifies an action and may appear on multiple events. request_update_event.reason is edited or reopened. Only edited events have request_changed_field rows.&lt;/p&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=#bac8d2;fillColor=#ffffff;fontColor=#19303f;">
          <mxGeometry x="780" y="620" width="700" height="200" as="geometry" />
        </mxCell>
        <mxCell id="rule-6" parent="1" vertex="1" value="&lt;div style=&quot;font-family:Arial;padding:16px&quot;&gt;&lt;b style=&quot;font-size:18px&quot;&gt;Domains and ending fields&lt;/b&gt;&lt;p style=&quot;font-size:15px;line-height:1.5&quot;&gt;Quantity and exact weights are positive; request_seq is at least 1; start_hour is 0–23. Status and end_reason use the documented domains. ended_at and end_reason are set together. Delivered requires collection and one evidence-backed delivery.&lt;/p&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=#bac8d2;fillColor=#ffffff;fontColor=#19303f;">
          <mxGeometry x="40" y="850" width="700" height="200" as="geometry" />
        </mxCell>
        <mxCell id="rule-7" parent="1" vertex="1" value="&lt;div style=&quot;font-family:Arial;padding:16px&quot;&gt;&lt;b style=&quot;font-size:18px&quot;&gt;Role and source reconstruction&lt;/b&gt;&lt;p style=&quot;font-size:15px;line-height:1.5&quot;&gt;Joining on PK/FK subtype links reconstructs role/source without multiplying rows. View-level resident_id, volunteer_id, request IDs, earnedAs and metadata can be assembled from the normalized relations.&lt;/p&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=#bac8d2;fillColor=#ffffff;fontColor=#19303f;">
          <mxGeometry x="780" y="850" width="700" height="200" as="geometry" />
        </mxCell>
        <mxCell id="rule-8" parent="1" vertex="1" value="&lt;div style=&quot;font-family:Arial;padding:16px&quot;&gt;&lt;b style=&quot;font-size:18px&quot;&gt;Reference data&lt;/b&gt;&lt;p style=&quot;font-size:15px;line-height:1.5&quot;&gt;Category identifiers remain laptops, desktops, monitors, tvs, phones, tablets, printers, small-appliances and cables-chargers. Names, waste types and standard weights remain category facts.&lt;/p&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=#bac8d2;fillColor=#ffffff;fontColor=#19303f;">
          <mxGeometry x="40" y="1080" width="700" height="200" as="geometry" />
        </mxCell>
        <mxCell id="rule-9" parent="1" vertex="1" value="&lt;div style=&quot;font-family:Arial;padding:16px&quot;&gt;&lt;b style=&quot;font-size:18px&quot;&gt;Historical values&lt;/b&gt;&lt;p style=&quot;font-size:15px;line-height:1.5&quot;&gt;Pickup addresses and estimated weights are request-time facts. Award points and formulas are award-time facts. Current status, expiry and totals are derived from their source relations.&lt;/p&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=#bac8d2;fillColor=#ffffff;fontColor=#19303f;">
          <mxGeometry x="780" y="1080" width="700" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>