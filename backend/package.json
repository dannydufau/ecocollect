{
  "name": "ecocollect-backend",
  "version": "1.0.0",
  "private": true,
  "description": "EcoCollect backend services: one image, each service started with its own entry point",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js test/nfr/*.test.js \"test/request/**/*.test.ts\"",
    "test:integration": "bash scripts/test-integration.sh",
    "test:nfr": "node --test --test-concurrency=1 test/nfr/*.test.js",
    "typecheck": "tsc -p src/request",
    "test:request": "node --test --test-concurrency=1 \"test/request/**/*.test.ts\""
  },
  "dependencies": {
    "@imagekit/nodejs": "^7.15.0",
    "amqplib": "^2.2.0",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "pg": "^8.23.1",
    "valibot": "^1.5.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
