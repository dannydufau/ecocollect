{
  "name": "ecocollect-backend",
  "version": "1.0.0",
  "private": true,
  "description": "EcoCollect backend: API server (auth, requests) and notification service",
  "main": "src/api/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/api/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:integration": "bash scripts/test-integration.sh",
    "typecheck": "tsc -p src/request",
    "test:request": "node --test --test-concurrency=1 \"test/request/**/*.test.ts\""
  },
  "dependencies": {
    "amqplib": "^2.2.0",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
