# Copy to .env and set your own values. Never commit .env.

# --- Postgres (used by docker-compose.yml) ---
POSTGRES_USER=ecocollect
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ecocollect
POSTGRES_PORT=5432

# --- Added in later ---
# Request service, used by `npm start` in backend/ (password must match POSTGRES_PASSWORD).
# From inside a container use the host `postgres` instead of `localhost`.
DATABASE_URL=postgres://ecocollect:change_me@localhost:5432/ecocollect

# Firebase Admin key for the request service and seed (see secrets/README.md).
# With `docker compose up` save the key as secrets/firebase-admin.json, Compose mounts it for the backend.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin.json

# Demo user password used by the seed script (scripts/seed).
# Optional with Firebase Auth Emulator; the default is EmulatorDemo1234!
# Required when using a real Firebase project.
# Set your own password in the private .env file.
# DEMO_PASSWORD=

# RabbitMQ
RABBITMQ_USER=ecocollect
RABBITMQ_PASSWORD=change_me
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Services run with npm start reach the broker on localhost.
RABBITMQ_URL=amqp://ecocollect:change_me@localhost:5672

# --- Frontend (docker compose builds it with these) ---
# Firebase web config: Firebase console > Project settings > General > Your apps > Web app.
# Public values, they end up in the browser code. Same names as frontend/.env.example.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ecocollect-uofc.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ecocollect-uofc
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Passwords go into connection URLs, so keep POSTGRES_PASSWORD and RABBITMQ_PASSWORD to letters, numbers and _ or -.
