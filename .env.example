# Copy to .env and set your own values. Never commit .env.

# --- Postgres (used by docker-compose.yml) ---
POSTGRES_USER=ecocollect
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ecocollect
POSTGRES_PORT=5432

# User Service login. Set its password with backend/scripts/user/load-db.sh.
USER_DB_PASSWORD=change_me
USER_DATABASE_URL=postgres://ecocollect_user:change_me@postgres:5432/ecocollect


# Reward Service login. Set its password with backend/scripts/reward/load-db.sh.
REWARD_DB_PASSWORD=change_me
REWARD_DATABASE_URL=postgres://ecocollect_reward:change_me@postgres:5432/ecocollect

# Cleanup Service login. Set its password with backend/scripts/cleanup/load-db.sh.
CLEANUP_DB_PASSWORD=change_me
CLEANUP_DATABASE_URL=postgres://ecocollect_cleanup:change_me@postgres:5432/ecocollect

# Notification Service login. Set its password with backend/scripts/notification/load-db.sh.
NOTIFICATION_DB_PASSWORD=change_me
NOTIFICATION_DATABASE_URL=postgres://ecocollect_notification:change_me@postgres:5432/ecocollect

# --- Added in later ---
# Admin connection for scripts run on this machine, like the load-db.sh scripts (password must match POSTGRES_PASSWORD).
# From inside a container use the host `postgres` instead of `localhost`.
DATABASE_URL=postgres://ecocollect:change_me@localhost:5432/ecocollect

# Firebase Admin key for the User Service (see secrets/README.md).
# With `docker compose up` save the key as secrets/firebase-admin.json, Compose mounts it only for User.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin.json

# RabbitMQ
RABBITMQ_USER=ecocollect
RABBITMQ_PASSWORD=change_me
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Services run outside Compose reach the broker on localhost.
RABBITMQ_URL=amqp://ecocollect:change_me@localhost:5672

# Request Service login. Set its password with backend/scripts/request/load-db.sh.
REQUEST_DB_PASSWORD=change_me
REQUEST_DATABASE_URL=postgres://ecocollect_request:change_me@postgres:5432/ecocollect

# --- Request Service: ImageKit (contracts/README.md 2.4) ---
# ImageKit dashboard > Developer options > API keys. The private key stays in the
# Request Service only; the frontend needs no ImageKit config.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=
# Every upload folder starts with this (6.2).
IMAGEKIT_ROOT_FOLDER=/ecocollect

# --- Frontend (docker compose builds it with these) ---
# Firebase web config: Firebase console > Project settings > General > Your apps > Web app.
# Public values, they end up in the browser code. Same names as frontend/.env.example.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ecocollect-uofc.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ecocollect-uofc
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Web push public VAPID key (contracts/README.md 16.8). Public value, not a secret.
# Must be the same value as VAPID_PUBLIC_KEY below. Rebuild the frontend after changing it.
NEXT_PUBLIC_VAPID_KEY=
# Leave false: demo mode is not part of the app.
NEXT_PUBLIC_DEMO=false

# Passwords go into connection URLs, so keep POSTGRES_PASSWORD and RABBITMQ_PASSWORD to letters, numbers and _ or -.

# Web Push (VAPID), required by the notification service. Generate with: npx web-push generate-vapid-keys
# Keep the pair stable: new keys invalidate every browser's subscription.
# Put the public key in NEXT_PUBLIC_VAPID_KEY above too: if they differ, pushes fail.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- VM only (docs/deploy-oracle-vm.md), leave empty or commented on your laptop ---
# The site's domain, for example ecocollect.duckdns.org. Read only by docker-compose.prod.yml.
SITE_ADDRESS=
# Makes a plain `docker compose ...` also use docker-compose.prod.yml (public ports 80/443).
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
