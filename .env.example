# Copy to .env and set your own values. Never commit .env.

# --- Postgres (used by docker-compose.yml) ---
POSTGRES_USER=ecocollect
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ecocollect
POSTGRES_PORT=5432

# --- Added in later ---
# Request service, used by `npm start` in backend/ (password must match POSTGRES_PASSWORD).
# From inside a container use the host `postgres` instead of `localhost`.
DATABASE_URL=postgres://ecocollect:change_me@localhost:5432/ecocollect

# Demo user password for the seed script.
# Optional when using the Firebase Auth Emulator.
# Required when using a real Firebase project.
# DEMO_PASSWORD=EmulatorDemo1234!

# Firebase Admin key for the request service and seed (see secrets/README.md)
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin.json

# RabbitMQ
RABBITMQ_USER=ecocollect
RABBITMQ_PASSWORD=change_me
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Services run with npm start reach the broker on localhost.
RABBITMQ_URL=amqp://ecocollect:change_me@localhost:5672
